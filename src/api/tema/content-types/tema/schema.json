{
  "kind": "collectionType",
  "collectionName": "temas",
  "info": {
    "singularName": "tema",
    "pluralName": "temas",
    "displayName": "Tema"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string"
    },
    "contenido": {
      "type": "text"
    },
    "Archivo": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "materias": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::materia.materia",
      "mappedBy": "temas"
    },
    "grado": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::grado.grado"
    }
  }
}
